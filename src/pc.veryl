// src/pc_plus4.veryl

module Pc (
    i_clk  : input  clock               ,
    i_reset: input  reset_async_high    ,
    i_pc   : input  logic           <32>,
    o_pc   : output logic           <32>,
) {
    var pc: logic<32>;

    always_ff (i_clk, i_reset) {
        if_reset {
            pc = 0;
        } else {
            pc = i_pc;
        }

    }
    assign o_pc = pc;
}
