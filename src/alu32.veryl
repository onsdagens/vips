// src/alu32.veryl

module Alu32 (
    a  : input  logic<32>,
    b  : input  logic<32>,
    sub: input  logic    ,
    op : input  logic<2> ,
    r  : output logic<32>,
    v  : output logic    ,
    c  : output logic    ,
    z  : output logic    ,
) {
    inst alu32: Alu (
        a    ,
        b    ,
        sub  ,
        op   ,
        r    ,
        v    ,
        c    ,
        z    ,
    );
}
