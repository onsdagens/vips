// src/pc_plus4.veryl

module PcPlus4 (
    i_clk  : input  clock               ,
    i_reset: input  reset_async_high    ,
    o_pc   : output logic           <32>,
) {
    var pc   : logic<32>;
    var sum  : logic<32>;
    var carry: logic    ;

    inst adder: Adder #(
        Width: 32,
    ) (
        a    : pc,
        b    : 4 ,
        sum      ,
        carry    ,
    );

    always_ff (i_clk, i_reset) {
        if_reset {
            pc = 0;
        } else {
            pc = sum;
        }

    }
    assign o_pc = pc;
}
