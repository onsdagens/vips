// src/vips.veryl

module Vips (
    i_clk: input clock,
    // electrically the reset signal is active low,
    //i_reset_n: input  reset_async_low,
    i_reset: input  reset,
    led0   : output logic,
    led1   : output logic,
    led2   : output logic,
    led3   : output logic,
    // i_dbg_reg     : input  logic           <5> ,
    // i_dbg_dm_addr : input  logic           <32>,
    // o_dbg_reg_data: output logic           <32>,
    // o_dbg_dm_data : output logic           <32>,
) {
    // rest of Vips assumes reset is active high, so flip the physical reset signal
    //let i_reset: reset = ~i_reset_n;
    //var i_clk  : clock;
    //inst osc: $sv::OSC_TOP (
    //    clk: i_clk,
    //);

    /* verilator lint_off UNOPTFLAT */
    var pc     : logic<32>;
    var pc_next: logic<32>;

    // pc register
    inst pc_reg: Pc (
        i_clk           ,
        i_reset         ,
        i_pc   : pc_next,
        o_pc   : pc     ,
    );

    var pc_plus4: logic<32>;

    inst pc_adder: Adder (
        a    : pc      ,
        b    : 32'h04  ,
        sum  : pc_plus4,
        carry: _       , // wrapping addition, so don't care
    );

    var wb_data  : logic<32>;
    var pc_sel   : logic<2> ;
    var pc_branch: logic<32>; // relative
    var pc_jump  : logic<32>; // 26 bit immediate

    var pc_mux_input   : logic<32> [4];
    assign pc_mux_input[0] = pc_plus4;
    assign pc_mux_input[1] = wb_data;
    assign pc_mux_input[2] = pc_branch;
    assign pc_mux_input[3] = pc_jump;
    inst pc_mux: Mux4 (
        i_data: pc_mux_input,
        i_sel : pc_sel      ,
        o_data: pc_next     ,
    );

    var instr: logic<32>;

    inst instr_mem: InstrMem (
        i_addr : pc   ,
        o_instr: instr,
    );

    assign pc_jump = {pc_plus4[31:28], instr[25:0], 2'b00};

    let opcode: logic<6>  = instr[31:26];
    let funct : logic<6>  = instr[5:0];
    let rs    : logic<5>  = instr[25:21];
    let rt    : logic<5>  = instr[20:16];
    let rd    : logic<5>  = instr[15:11];
    let imm   : logic<16> = instr[15:0];

    var w_reg_sel   : logic   ;
    var z           : logic   ;
    var rf_we       : logic   ;
    var imm_sign_ext: logic   ;
    var alu_b_sel   : logic   ;
    var alu_sub     : logic   ;
    var alu_op      : logic<2>;
    var dm_we       : logic   ;
    var d_sel       : logic   ;
    var branch_eq   : logic   ;

    inst decoder: Decoder (
        i_opcode      : opcode      ,
        i_funct       : funct       ,
        i_z           : z           ,
        i_eq          : branch_eq   ,
        o_w_reg_sel   : w_reg_sel   ,
        o_rf_we       : rf_we       ,
        o_imm_sign_ext: imm_sign_ext,
        o_alu_b_sel   : alu_b_sel   ,
        o_alu_sub     : alu_sub     ,
        o_alu_op      : alu_op      ,
        o_dm_we       : dm_we       ,
        o_d_sel       : d_sel       ,
        o_pc_sel      : pc_sel      ,
    );

    var wb_reg: logic<5>;

    var reg_d_mux_input   : logic<5> [2];
    assign reg_d_mux_input[0] = rt;
    assign reg_d_mux_input[1] = rd;

    inst reg_d_mux: Mux2 #(
        Width: 5,
    ) (
        i_data: reg_d_mux_input,
        i_sel : w_reg_sel      ,
        o_data: wb_reg         ,
    );

    var alu_r  : logic<32>;
    var dm_data: logic<32>;

    // write back data
    var wb_mux_input   : logic<32> [2];
    assign wb_mux_input[0] = alu_r;
    assign wb_mux_input[1] = dm_data;

    inst wb_mux: Mux2 (
        i_data: wb_mux_input,
        i_sel : d_sel       ,
        o_data: wb_data     ,
    );

    var a_data: logic<32>;
    var b_data: logic<32>;

    let fake_i_dbg_addr: logic<5> = 0;
    inst regfile: RegFile (
        i_clk                      ,
        i_reset                    ,
        i_a_addr  : rs             ,
        i_b_addr  : rt             ,
        i_w_ena   : rf_we          ,
        i_w_addr  : wb_reg         ,
        i_w_data  : wb_data        ,
        i_dbg_addr: fake_i_dbg_addr,
        o_a_data  : a_data         ,
        o_b_data  : b_data         ,
        o_dbg_data: _              ,
    );

    inst branch: Branch (
        i_a : a_data   ,
        i_b : b_data   ,
        o_eq: branch_eq,
    );

    var imm32ext: logic<32>;

    inst extend16to32: Extend16to32 (
        i_data    : imm         ,
        i_sign_ext: imm_sign_ext,
        o_data    : imm32ext    ,
    );

    inst branch_adder: Adder (
        a    : imm32ext << 2,
        b    : pc_plus4     ,
        sum  : pc_branch    ,
        carry: _            , // we don't care if carry set
    );

    var alu_src             : logic<32>    ;
    var alu_src_mux_input   : logic<32> [2];
    assign alu_src_mux_input[0] = b_data;
    assign alu_src_mux_input[1] = imm32ext;
    inst alu_src_mux: Mux2 (
        i_data: alu_src_mux_input,
        i_sel : alu_b_sel        ,
        o_data: alu_src          ,
    );

    inst alu: Alu (
        a  : a_data ,
        b  : alu_src,
        sub: alu_sub,
        op : alu_op ,
        r  : alu_r  ,
        v  : _      , // trap on arithmetic overflow
        c  : _      , // not used
        z           , // not used, but connected
    );

    inst data_mem: DataMem (
        i_clk           ,
        i_reset         ,
        i_we   : dm_we  ,
        i_addr : alu_r  ,
        i_data : b_data ,
        o_data : dm_data,
        led0            ,
        led1            ,
        led2            ,
        led3            ,
    );

    // inst wb_mux : Mux2

}

#[test(vips)]
module VipsTest {

    inst clk: $tb::clock_gen #( period: 10 );
    inst rst: $tb::reset_gen (
        clk  ,
